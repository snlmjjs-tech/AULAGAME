{
  "rules": {
    "pines": {
      "$pin": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "salasVivo": {
      "$juego": {
        "$sala": {
          ".read": true,

          "meta": { ".write": "auth != null" },
          "equipoActivo": { ".write": "auth != null" },
          "paused": { ".write": "auth != null" },
          "gameOver": { ".write": "auth != null" },
          "estado": { ".write": "auth != null" },
          "equipos": { ".write": "auth != null" },
          "turno": { ".write": "auth != null" },

          "jugadores": {
            ".write": "auth != null",
            "$jugadorId": {
              ".write": "auth != null || !data.exists()"
            }
          },

          "buzz": {
            ".write": "auth != null",
            "$jugadorId": {
              ".write": "auth != null || !data.exists()"
            }
          },

          "respuestas": {
            ".write": "auth != null",
            "$equipoId": {
              ".write": "auth != null || (newData.child('jugadorId').val() != null && root.child('salasVivo/'+$juego+'/'+$sala+'/jugadores/'+newData.child('jugadorId').val()+'/equipoId').val() === $equipoId)"
            }
          },

          "$otroCampo": {
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
