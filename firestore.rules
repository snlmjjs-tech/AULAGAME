rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada profe solo puede leer/escribir su propio documento,
    // identificado por su uid de Firebase Authentication.
    match /profes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Los campos "plan" ("gratis" | "premium"), "trialUsado" y "trialFin" no los
      // puede tocar el propio profe desde el cliente — "plan" solo se activa a mano
      // desde la consola de Firebase, y "trialUsado"/"trialFin" (demo Premium de 5
      // días) solo los escribe el Cloudflare Worker (endpoint /start-trial) con la
      // cuenta de servicio, que no pasa por estas reglas. Así nadie se auto-asigna
      // premium ni se alarga la demo editando la consola del navegador.
      allow create: if request.auth != null && request.auth.uid == uid
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'gratis')
        && !('trialUsado' in request.resource.data)
        && !('trialFin' in request.resource.data)
        && !('trialInicio' in request.resource.data)
        && !('aiTrialUsos' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('plan', 'gratis') == resource.data.get('plan', 'gratis')
        && request.resource.data.get('trialUsado', false) == resource.data.get('trialUsado', false)
        && request.resource.data.get('trialFin', null) == resource.data.get('trialFin', null)
        && request.resource.data.get('trialInicio', null) == resource.data.get('trialInicio', null)
        && request.resource.data.get('aiTrialUsos', 0) == resource.data.get('aiTrialUsos', 0);
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Contenido editable de cada juego (preguntas, rondas, configuración...),
      // un documento por juego, para que sincronice entre dispositivos.
      match /datosJuegos/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Links cortos (ej. aulagame.cl/H0799) que redirigen a una sala/PIN de
    // un juego en vivo. Lectura pública porque el alumno que escanea el QR
    // no tiene sesión iniciada. Solo el profesor (autenticado) puede crear
    // uno nuevo al generar una sala; nunca se editan ni se borran desde el
    // cliente — cada sala nueva simplemente crea un código nuevo.
    match /codigosCortos/{codigo} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['juego','destino','paramNombre','paramValor','extraQuery','creadoEn'])
        && request.resource.data.juego is string
        && request.resource.data.destino is string
        && request.resource.data.paramNombre is string
        && request.resource.data.paramValor is string;
      allow update, delete: if false;
    }

    // Intranet de Inglés: clases publicadas por el profe (link y/o imagen).
    // No hay Firebase Authentication real en esta intranet (login propio con
    // clave numérica), así que se deja abierto igual que storage.rules.
    match /clasesIngles/{claseId} {
      allow read, write: if true;
    }
  }
}
